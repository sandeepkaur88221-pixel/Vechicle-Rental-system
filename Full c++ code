class Vehicle
{
protected:
    int id;
    string name;
    double rent;
    bool available;

public:
    Vehicle(int i, string n, double r)
    {
        id = i;
        name = n;
        rent = r;
        available = true;
    }

    virtual void display()
    {
        cout << id << "\t" << name << "\tRs. "
             << rent << "\t"
             << (available ? "Available" : "Rented")
             << endl;
    }

    int getId()
    {
        return id;
    }

    bool isAvailable()
    {
        return available;
    }

    void rentVehicle()
    {
        available = false;
    }

    void returnVehicle()
    {
        available = true;
    }

    double calculateRent(int days)
    {
        return rent * days;
    }

    virtual ~Vehicle() {}
};

